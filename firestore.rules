rules_version = '2';

// =====================================================================
// Jozz D&D Character Sheet — Firestore Security Rules
// =====================================================================
// Deploy with:  firebase deploy --only firestore:rules
// or paste this whole file into Firebase Console → Firestore → Rules.
//
// Model:
//  - A user owns userData/{their uid} and everything under it. Nobody else
//    can read or list their sheets. (There is no DM link to player sheets.)
//  - The owner-admin (vanreejoz33) can READ every document (admin page: overview,
//    backup, users, sheets). Beyond reading, the admin can only: restore a
//    deleted sheet (update), manage admin_config, and delete old leftovers from
//    the removed DM tool (campaigns, members, joinRequests, dm_requests).
//  - Campaigns no longer exist as a feature: nobody can write them.
// =====================================================================

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwnerAdmin() {
      return isSignedIn() && request.auth.token.email == 'vanreejoz33@gmail.com';
    }

    // A sheet or prefs doc is a small map of fields. 1 MB is Firestore's own
    // hard limit; this stops junk docs with hundreds of keys.
    function sane() {
      return request.resource.data.keys().size() <= 60;
    }

    // ---- User data (prefs + characters subcollection) ----
    match /userData/{uid} {
      allow read: if isSignedIn() && request.auth.uid == uid;
      allow write: if isSignedIn() && request.auth.uid == uid && sane();
      allow delete: if isSignedIn() && request.auth.uid == uid;
      allow read: if isOwnerAdmin();

      match /characters/{charId} {
        allow read: if isSignedIn() && request.auth.uid == uid;
        allow create, update: if isSignedIn() && request.auth.uid == uid && sane();
        allow delete: if isSignedIn() && request.auth.uid == uid;
        allow read: if isOwnerAdmin();
        // Admin "restore deleted sheet": may only flip the deleted flag back (and bump rev / updatedAt)
        allow update: if isOwnerAdmin()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['deleted', 'deletedAt', 'rev', 'updatedAt']);
      }
    }

    // ---- collectionGroup read of all characters (admin portal only) ----
    match /{path=**}/characters/{charId} {
      allow read: if isOwnerAdmin();
    }

    // ---- User profiles (display names) ----
    // Single profile lookups stay open to signed-in users; listing every
    // profile (names + emails) is admin only.
    match /userProfiles/{uid} {
      allow get: if isSignedIn();
      allow list: if isOwnerAdmin();
      allow write: if isSignedIn() && request.auth.uid == uid && sane();
    }

    // ---- Sign-in history / presence ----
    match /auth_signins/{uid} {
      allow read, write: if isSignedIn() && request.auth.uid == uid;
      allow read: if isOwnerAdmin();
    }

    // ---- Campaigns: the DM tool was removed. Old docs are left for the owner-admin to read, back up
    // and delete. Nobody can create or change one any more (the admin blanket read also covers reads). ----
    match /campaigns/{campaignId} { allow read, delete: if isOwnerAdmin(); }

    // ---- Old link-system leftovers: only the owner-admin can see or delete them ----
    match /campaigns/{campaignId}/members/{m} { allow read, delete: if isOwnerAdmin(); }
    match /campaigns/{campaignId}/joinRequests/{j} { allow read, delete: if isOwnerAdmin(); }
    match /dm_requests/{d} { allow read, delete: if isOwnerAdmin(); }

    // ---- Admin config (portal PIN hash) ----
    // Only the owner-admin portal uses this; nobody else needs the PIN hash.
    match /admin_config/{docId} {
      allow read, write: if isOwnerAdmin();
    }

    // ---- Owner-admin can read anything (admin page: overview, backup, usage) ----
    match /{document=**} {
      allow read: if isOwnerAdmin();
    }
  }
}
